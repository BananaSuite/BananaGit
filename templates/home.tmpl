{{/* BananaGit: our own home page (bananagit/OURS); its data is BananaGitHome (routers/web/bananagit/home.go) */}}
{{template "base/head" .}}
{{$home := .BananaGitHome}}
<div role="main" aria-label="{{ctx.Locale.Tr "home_title"}}" class="page-content bananagit-home">
	<div class="ui container tw-flex tw-flex-col tw-items-center tw-text-center tw-gap-4 tw-py-8">
		<img width="120" height="120" src="{{AssetUrlPrefix}}/img/logo.svg" alt="{{ctx.Locale.Tr "logo"}}">
		<h1 class="ui header tw-m-0">{{AppName}}</h1>
		{{with $home.Description}}<p class="tw-text-balance tw-m-0">{{.}}</p>{{end}}
		{{if not .IsSigned}}
			<div class="tw-flex tw-flex-wrap tw-justify-center tw-gap-2 tw-mt-4">
				{{with $home.HostingProvider}}
					<a class="ui primary button" rel="nofollow" href="{{AppSubUrl}}/user/oauth2/{{.DisplayName | PathEscape}}">{{ctx.Locale.Tr "sign_in_with_provider" .DisplayName}}</a>
				{{end}}
				{{if $home.ShowSignIn}}
					<a class="ui button" rel="nofollow" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>
				{{end}}
				{{if $home.ShowExplore}}
					<a class="ui basic button" href="{{AppSubUrl}}/explore/repos">{{ctx.Locale.Tr "bananagit.home.explore"}}</a>
				{{end}}
			</div>
		{{end}}
		{{if or $home.WikiURL $home.ChatURL}}
			<nav class="tw-flex tw-flex-wrap tw-justify-center tw-gap-4 tw-mt-4" aria-label="{{ctx.Locale.Tr "bananagit.home.suite"}}">
				{{with $home.WikiURL}}<a href="{{.}}">{{ctx.Locale.Tr "bananagit.home.wiki"}}</a>{{end}}
				{{with $home.ChatURL}}<a href="{{.}}">{{ctx.Locale.Tr "bananagit.home.chat"}}</a>{{end}}
			</nav>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
